# LLM CALL API
OPENR_API=your-openrouter-api-key
CLDFLR_API=your-cloudflare-api-key
GEMINI_API=your-gemini-api-key

# LANGFUSE API for monitoring
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hirepulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hirepulse

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hirepulse-uploads
MINIO_SECURE=false


# Optional: scope classifier with structured tool-call output
ROUTER_MODEL_NAME=mistralai/ministral-3b-2512
ENABLE_JINA_FALLBACK=false
# Optional least-privilege token for public GitHub reads
# GITHUB_READ_TOKEN=

# Set to decisions to enable OpenRouter's Decisions API instead of chat.
ROUTER_BACKEND=chat
DECIDER_MODEL=perplexity/pplx-decider-flash-v1.3:free
